# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editors / IDEs ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Node (for tooling, if ever used) ----
node_modules/
npm-debug.log*

# ---- Robotic / experiment artifacts (keep the repo light) ----
data/raw/
data/dumps/
runs/
logs/
*.log
*.bag
recordings/
video/

# Heavy binaries that should not live in git
*.mp4
*.mov
*.avi
*.mkv

# STL/STEP are welcome once they are final; until then prefer source CAD
# and export on release. Uncomment to allow them:
# !hardware/cad/*.stl

# ---- Secrets ----
*.pem
*.key
secrets.yaml
config.local.yaml

# ---- Calibration captures (large, per-device) ----
calib/*/images/
calib/*/*.png
calib/*/*.jpg
!calib/**/README.md
!calib/**/result.json

# ---- Temporary ----
tmp/
_temp/
*.tmp
